# ── Supabase (public values, safe for the browser) ─────────────────────────
# Leave both empty to run in demo mode with the fictional demo user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where magic links should return to. Set this in production (e.g. https://app.grown.com).
# Locally it is inferred from the request.
NEXT_PUBLIC_SITE_URL=

# ── Server-only secrets. NEVER prefix these with NEXT_PUBLIC_. ─────────────
SUPABASE_SERVICE_ROLE_KEY=
# Only for scripts/*.mjs that talk to the Supabase Management API (scoped token: Database + Migrations).
# Not read by the app. Delete the token in the dashboard when the maintenance work is done.
# SUPABASE_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# Some hosting environments reserve the ANTHROPIC_API_KEY name and never pass it to the app.
# Set the key under this name instead; it is read first.
# GROWN_ANTHROPIC_API_KEY=

# ── GROWN. Intelligence (Stage 3+) ──────────────────────────────────────────
# GROWN_ANALYSIS_DAILY_LIMIT=5
# GROWN_AI_RAW_LOG_RETENTION_DAYS=14

# ── GROWN. Intelligence (Stage 3) ───────────────────────────────────────────
# Provider: "anthropic" (default when ANTHROPIC_API_KEY is set), "fixture" (scripted test data), or "none".
# Set GROWN_AI_PROVIDER=anthropic explicitly when the hosting environment injects the key as a managed
# credential instead of an environment variable; the app then needs no ANTHROPIC_API_KEY of its own.
# GROWN_AI_PROVIDER=anthropic
# Model overrides (verified against the Models endpoint at runtime; default claude-opus-5-5)
# GROWN_AI_MODEL=claude-opus-5-5
# GROWN_AI_MODEL_RESOLVE=
# GROWN_AI_MODEL_RESEARCH=
# GROWN_AI_MODEL_EXTRACT=
# GROWN_AI_MODEL_LABEL=
# Paste a Link refuses private/loopback hosts. Tests set this to read a local stand-in page. Never in production.
# GROWN_LINK_ALLOW_LOCAL=1
# GROWN_AI_MODEL_PERSONALIZE=
# Limits and lifetimes (env overrides app_config; app_config overrides code defaults)
# GROWN_ANALYSIS_DAILY_LIMIT=5
# GROWN_RESEARCH_TTL_DAYS=30
# GROWN_PRICING_TTL_DAYS=7
# GROWN_GOAL_SUPPLEMENT_TTL_DAYS=30
# Prompt caching on research calls: ON by default (measured 59% cheaper, same quality). Set off to disable.
# GROWN_AI_PROMPT_CACHE=off
# Raw AI debugging logs: short retention, or off
# GROWN_AI_RAW_LOG_RETENTION_DAYS=14
# GROWN_AI_RAW_LOGS=off
